---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/date';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  readingTime: number;
  prev: { href: string; title: string } | null;
  next: { href: string; title: string } | null;
}

const { post, readingTime, prev, next } = Astro.props;
const { title, description, feature, pubDate, series } = post.data;

const kicker = series
  ? `${series.name.toUpperCase()} · PART ${series.part} OF ${series.total}`
  : null;
---
<BaseLayout title={title} description={description} feature={feature}>
  <article class="post">
    <header class="post-head">
      {kicker && <p class="kicker">{kicker}</p>}
      <h1>{title}</h1>
      {description && <p class="standfirst">{description}</p>}
      <p class="meta">{formatDate(pubDate)} · {readingTime} min read</p>
    </header>

    <div class="prose">
      <slot />
    </div>

    {(prev || next) && (
      <nav class="series-nav" aria-label="Series">
        {prev
          ? <a class="prev" href={prev.href}>← {prev.title}</a>
          : <span class="prev disabled">← Previous</span>}
        {next
          ? <a class="next" href={next.href}>{next.title} →</a>
          : <span class="next disabled">Next →</span>}
      </nav>
    )}
  </article>
</BaseLayout>
