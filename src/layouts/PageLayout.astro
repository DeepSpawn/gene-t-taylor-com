---
import BaseLayout from './BaseLayout.astro';

interface FrontmatterProps {
  title?: string;
  description?: string;
  feature?: string;
  noSocial?: boolean;
}

interface Props extends FrontmatterProps {
  // Markdown pages using `layout:` pass their frontmatter here, not as top-level props.
  frontmatter?: FrontmatterProps;
}

const fm = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? fm.title;
const description = Astro.props.description ?? fm.description;
const feature = Astro.props.feature ?? fm.feature;
const noSocial = Astro.props.noSocial ?? fm.noSocial;
---
<BaseLayout title={title} description={description} feature={feature} noSocial={noSocial}>
  <article class="page">
    <header class="page-head">
      <h1>{title}</h1>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
