---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';

const allPosts = await getCollection('posts', ({ data }) => data.published !== false);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<BaseLayout
  title="Recent Posts"
  description="Gene Taylor — engineering manager at Atlassian. Notes on building software, leading teams, and the occasional detour."
  feature="typewriter.jpg"
  dark={false}
>
  <section class="article">
    <div class="overlay"></div>
    <div class="featured-image" style="background-image: url(/images/typewriter.jpg)"></div>
    <article class="wrap post">
      <header class="post-header home-intro">
        <h1>Gene Taylor</h1>
        <p class="intro">
          Senior Engineering Manager at <a href="https://atlassian.com">Atlassian</a> in Sydney. I've spent the last decade building and leading teams in and around Jira's developer-tools space. <a href="/about/">More about me</a> — or read on for things I've written.
        </p>
      </header>
    </article>
  </section>
  <PostList posts={recentPosts} heading="Recent Posts" />
</BaseLayout>
