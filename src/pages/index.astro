---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';

const allPosts = await getCollection('posts', ({ data }) => data.published !== false);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---
<BaseLayout
  title={undefined}
  description="Gene Taylor — engineering manager at Atlassian. Notes on building software, leading teams, and the occasional detour."
>
  <section class="home-intro">
    <h1>Gene Taylor</h1>
    <p class="lede">
      Senior Engineering Manager at <a href="https://atlassian.com">Atlassian</a> in Sydney. I've spent the last decade building and leading teams in and around Jira's developer-tools space. <a href="/about/">More about me</a> — or read on for things I've written.
    </p>
  </section>

  <section class="writing-section">
    <h2 class="section-title">Writing</h2>
    <PostList posts={recentPosts} />
    <p class="see-all"><a href="/archive/">All writing →</a></p>
  </section>
</BaseLayout>
