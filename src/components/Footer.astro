---
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/date';

const allPosts = await getCollection('posts', ({ data }) => data.published !== false);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<div class="push"></div>
<footer>
  <aside class="wrap">
    <ol class="prev-posts">
      <p class="list-title">Recent Posts</p>
      {recentPosts.map((post) => (
        <li>
          <span class="recent-title"><a href={`/posts/${post.slug}/`}>{post.data.title}</a></span>
          <span class="date">{formatDate(post.data.pubDate)}</span>
        </li>
      ))}
    </ol>

    <div class="social">
      <ul>
        <li><a id="mail" href="mailto:contact@gene-t-taylor.com"><span class="foot-link">Contact Me</span></a></li>
        <li><a id="twit" href="http://twitter.com/SplicedGene" target="_blank" rel="noopener"><span class="foot-link">@SplicedGene</span></a></li>
      </ul>
    </div>
  </aside>
  <small>© 2026 Gene Taylor. This work is licensed under a <a rel="license" href="http://creativecommons.org/licenses/by/4.0/">Creative Commons Attribution 4.0 International License</a> unless otherwise noted.</small>
</footer>
