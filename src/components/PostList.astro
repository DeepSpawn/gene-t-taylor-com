---
import type { CollectionEntry } from 'astro:content';
import { formatDate, formatDateISO } from '../lib/date';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;

const readingTime = (post: CollectionEntry<'posts'>) =>
  Math.max(1, Math.round(post.body.split(/\s+/).filter(Boolean).length / 230));
---
<ol class="writing-list">
  {posts.map((post) => (
    <li itemscope itemtype="http://schema.org/BlogPosting" itemprop="blogPost">
      {post.data.series && (
        <span class="w-kicker">{post.data.series.name} · Part {post.data.series.part}</span>
      )}
      <h2 class="w-title"><a href={`/posts/${post.slug}/`} itemprop="url">{post.data.title}</a></h2>
      <p class="w-meta">
        <time datetime={formatDateISO(post.data.pubDate)} itemprop="datePublished">{formatDate(post.data.pubDate)}</time>
        · {readingTime(post)} min read
      </p>
      <p class="w-desc" itemprop="description">{post.data.description}</p>
    </li>
  ))}
</ol>
